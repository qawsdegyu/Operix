{
  "version": 2,
  "builds": [
    {
      "src": "api-skeleton.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "operix/**"
      }
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api-skeleton.js"
    }
  ]
}
